{
  "name": "gopay-merchant-gateway",
  "version": "1.0.0",
  "description": "GoPay Merchant Payment Gateway & QRIS Verification API (Stateless)",
  "main": "server.js",
  "scripts": {
    "start": "bun run server.js",
    "dev": "bun --watch run server.js",
    "login": "bun run login.js",
    "test": "bun test",
    "build": "bun build ./server.js --target=bun --no-bundle",
    "benchmark": "bun run scripts/benchmark.js",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check ."
  },
  "dependencies": {
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2"
  }
}
