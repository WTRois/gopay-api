                "exec": [
                  "const res = pm.response.json();",
                  "if (res.success && res.data) {",
                  "    if (res.data.qris_id) {",
                  "        pm.collectionVariables.set('qrisId', res.data.qris_id);",
                  "        console.log('Saved qrisId:', res.data.qris_id);",
                  "    }",
                  "    if (res.data.trx_id) {",
                  "        pm.collectionVariables.set('trxId', res.data.trx_id);",
                  "        console.log('Saved trxId:', res.data.trx_id);",
                  "    }",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 50000\n}"
